[Unit]
Description=Plumbline uptime probe (one-shot, invoked by timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=plumbline-monitor
Group=plumbline-monitor
Environment=PLUMBLINE_MONITOR_DIR=/var/lib/plumbline-monitor
ExecStart=/usr/bin/python3 /opt/plumbline-monitor/collector/plumbline_uptime.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plumbline-monitor
ProtectHome=true
