# /etc/nginx/sites-available/status.reiers.io
#
# Static site for plumbline-monitor. Cloudflare orange-clouds the DNS,
# origin cert is the wildcard *.reiers.io Cloudflare Origin CA cert.
#
# Symlink into sites-enabled/ and reload nginx.

server {
    listen 80;
    listen [::]:80;
    server_name status.reiers.io;
    return 301 https://status.reiers.io$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name status.reiers.io;

    ssl_certificate     /etc/ssl/cloudflare/reiers.io.crt;
    ssl_certificate_key /etc/ssl/cloudflare/reiers.io.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    root  /opt/plumbline-monitor/web;
    index index.html;

    # Honour Cloudflare origin IP forwarding.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;

    # Assets are tiny; short cache with revalidation is fine.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }

    # 90-day uptime summary produced by the collector systemd timer.
    # Keep cache short so the frontend picks up new state within a few
    # minutes of the next probe.
    location = /uptime.json {
        alias /var/lib/plumbline-monitor/uptime.json;
        default_type application/json;
        add_header Cache-Control "public, max-age=60, must-revalidate";
        add_header Access-Control-Allow-Origin "*";
    }

    location /style.css {
        add_header Cache-Control "public, max-age=300, must-revalidate";
        types { text/css css; }
    }

    location /app.js {
        add_header Cache-Control "public, max-age=300, must-revalidate";
        types { application/javascript js; }
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }

    # Anything the browser needs from this origin can be scraped. Nothing
    # sensitive is served.
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header Referrer-Policy "no-referrer-when-downgrade";
}
